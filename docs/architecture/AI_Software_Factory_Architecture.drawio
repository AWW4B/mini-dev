ndArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l2_per" target="l2_out"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2_e61" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l2_out" target="l2_o02"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l3a" name="04 · LLD3a Orchestrator &amp; Planning"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="2902" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l3a_bg1" value="LLD 3a · Module 3: Main Orchestrator, Run Control &amp;amp; Planning Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2312.0" height="58.0" as="geometry"/></mxCell><mxCell id="l3a_bg2" value="The orchestrator is a deterministic, durable state machine; it holds no model context of its own. The Planning Agent is the only planning-tier model consumer, and it runs in a mode chosen by task type. Context &amp;amp; memory management moved to the shared Context &amp;amp; Memory Service (M5) because M2, M3 and M4 all need it. HITL is raised through the Decision Broker (M5) so pending decisions survive restarts." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="l3a_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="136.0" width="772.0" height="1292.0" as="geometry"/></mxCell><mxCell id="l3a_bg4" value="Main Orchestrator · run lifecycle (durable state machine)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7B45;strokeColor=#1E7B45;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="153.0" width="772.0" height="34.0" as="geometry"/></mxCell><mxCell id="l3a_bg5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1146.0" y="136.0" width="772.0" height="1292.0" as="geometry"/></mxCell><mxCell id="l3a_bg6" value="Run Control, Escalation &amp;amp; Recovery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7B45;strokeColor=#1E7B45;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1146.0" y="153.0" width="772.0" height="34.0" as="geometry"/></mxCell><mxCell id="l3a_bg7" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="1448.0" width="1564.0" height="1292.0" as="geometry"/></mxCell><mxCell id="l3a_bg8" value="Planning Agent · modes: DESIGN (new) · DIAGNOSIS (debug) · IMPACT (feature) · REFACTOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7B45;strokeColor=#1E7B45;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="1465.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l3a_bg9" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="2770.0" width="2252.0" height="92.0" as="geometry"/></mxCell><mxCell id="l3a_i02" value="&lt;b&gt;IN ◀ IF-02 StructuredRequest&lt;/b&gt;&lt;br&gt;from M2 Request Understanding&lt;br&gt;Payload: requirements, acceptance, assumptions, RepoProfile&lt;br&gt;Trigger: understanding complete" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_run" value="[MEM] Create Run: budgets&lt;br&gt;(tokens, API spend, wall-clock,&lt;br&gt;max nodes), policy profile" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="247.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l3a_ctx" value="[CTX] Load project memory:&lt;br&gt;decision log, contracts,&lt;br&gt;RepoProfile (bounded)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="383.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l3a_nb" value="New build?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l3a_dbg" value="Debug request?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l3a_mdes" value="Mode DESIGN" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_mdia" value="Mode DIAGNOSIS:&lt;br&gt;reproduce → localise" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_mimp" value="Mode IMPACT / REFACTOR:&lt;br&gt;contract delta, char-&lt;br&gt;acterisation tests" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_inv" value="Invoke Planning Agent&lt;br&gt;(mode + ContextPack)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_i10b" value="&lt;b&gt;IN ◀ IF-10b DecompositionReport&lt;/b&gt;&lt;br&gt;from M3 Recursive Decomposition&lt;br&gt;Payload: completeness audit, suspended nodes&lt;br&gt;Trigger: frontier empty / suspended" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="921.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_rpt" value="Receive decomposition&lt;br&gt;report" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_cmpl" value="Every requirement&lt;br&gt;traced to a test?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1054.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l3a_gapf" value="Re-plan uncovered&lt;br&gt;requirements (bounded:&lt;br&gt;2 rounds, then HITL)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1067.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_i10c" value="&lt;b&gt;IN ◀ IF-10c RootIntegrated&lt;/b&gt;&lt;br&gt;from M4 Integration &amp;amp; Repair&lt;br&gt;Payload: root integration evidence&lt;br&gt;Trigger: root node INTEGRATED" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1193.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_mon" value="Monitor run until root&lt;br&gt;integrated (escalations&lt;br&gt;handled on the right)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1203.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_acc" value="Final acceptance: matrix green,&lt;br&gt;regression green → run DONE,&lt;br&gt;report + decision log" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1339.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_done" value="Deliver report&lt;br&gt;(no auto-deploy)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#1E7B45;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1339.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_o17" value="&lt;b&gt;OUT ▶ IF-17 RunCompleted event&lt;/b&gt;&lt;br&gt;to M5 Event Stream → M1&lt;br&gt;Payload: report ref, metrics summary&lt;br&gt;Trigger: acceptance passed" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1329.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_i05" value="&lt;b&gt;IN ◀ IF-05 RunControl&lt;/b&gt;&lt;br&gt;from M1 Run Controls / History&lt;br&gt;Payload: command, scope, command_id&lt;br&gt;Trigger: user command" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_vcmd" value="Validate command id&lt;br&gt;(idempotent); authorise" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_cmd" value="Command?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1696.0" y="374.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l3a_pause" value="Pause: stop new dispatch,&lt;br&gt;checkpoint. Resume: run&lt;br&gt;reconciliation first" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_abort" value="Abort / cancel: scope →&lt;br&gt;CANCELLED; revoke leases;&lt;br&gt;keep artifacts and logs" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_bc" value="Broadcast control signal&lt;br&gt;with scope (run / subtree&lt;br&gt;/ task)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_o06" value="&lt;b&gt;OUT ▶ IF-06 CancelSignal / RunFlag&lt;/b&gt;&lt;br&gt;to M2, M4 Scheduler, M5 Runtime&lt;br&gt;Payload: run_id, scope, command&lt;br&gt;Trigger: pause, resume, abort, cancel" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="649.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_i20" value="&lt;b&gt;IN ◀ IF-20 ResourceAdvisory&lt;/b&gt;&lt;br&gt;from M5 Metrics &amp;amp; Monitoring&lt;br&gt;Payload: budget %, pressure, provider status&lt;br&gt;Trigger: threshold crossed" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="785.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_adv" value="Hard limit? (budget 100%,&lt;br&gt;no usable provider)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1696.0" y="782.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l3a_soft" value="Soft: log; scheduler&lt;br&gt;already throttles" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_hard" value="Pause run; ask user:&lt;br&gt;raise budget, switch&lt;br&gt;provider, or stop" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_o03" value="&lt;b&gt;OUT ▶ IF-03 DecisionRequest&lt;/b&gt;&lt;br&gt;to M5 Decision Broker → M1&lt;br&gt;Payload: escalation summary, options, default=suspend&lt;br&gt;Trigger: hard limit / escalation exhausted" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="921.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_i10" value="&lt;b&gt;IN ◀ IF-10 TaskOutcome = ESCALATED&lt;/b&gt;&lt;br&gt;from M4 Worker / Verification / Integration&lt;br&gt;Payload: class, evidence, attempts&lt;br&gt;Trigger: task-level budget exhausted" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="1057.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l3a_cls" value="Classify escalation: worker,&lt;br&gt;integration, split infeasible,&lt;br&gt;provider unavailable" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1067.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_bud" value="Run budget left and&lt;br&gt;re-plans &amp;lt; 2 for&lt;br&gt;this subtree?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1696.0" y="1190.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l3a_repl" value="Re-plan subtree with&lt;br&gt;evidence (spec / contract&lt;br&gt;revision via Planner)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="1203.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_hitl" value="User: add budget, edit&lt;br&gt;spec, waive criterion,&lt;br&gt;abandon subtree, abort" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1339.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_ps" value="Requirements + mode&lt;br&gt;+ ContextPack" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#1E7B45;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1563.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_rem" value="Planning tier reachable&lt;br&gt;and within budget?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1686.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l3a_deg" value="Degraded mode: local T2&lt;br&gt;planner + mandatory&lt;br&gt;plan approval" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_llm" value="LLM · T3 planning tier:&lt;br&gt;modules, interfaces, data&lt;br&gt;contracts, deps, acceptance" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1B2631;strokeColor=#F4D03F;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1835.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l3a_sch" value="Schema valid?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerim