;&lt;br&gt;rebuild frontier and&lt;br&gt;ready set" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="1291.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_rsm" value="Resume scheduler&lt;br&gt;unless run is paused" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1291.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_o06" value="&lt;b&gt;OUT ▶ IF-17 RunRecovered event&lt;/b&gt;&lt;br&gt;to M3, M4, M1 (via Event Stream)&lt;br&gt;Payload: run_id, reset tasks, pending decisions&lt;br&gt;Trigger: reconciliation done" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="1417.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5a_ck" value="Stage end or&lt;br&gt;checkpoint timer" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1563.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_bk" value="[MEM] Consistent online&lt;br&gt;backup (snapshot copy)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1559.0" w