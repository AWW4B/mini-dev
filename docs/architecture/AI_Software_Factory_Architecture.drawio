Geometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l4b" name="08 · LLD4b Verification &amp; Integration"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="3446" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l4b_bg1" value="LLD 4b · Module 4: Verification Gate and hierarchical Integration &amp;amp; Repair" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2312.0" height="58.0" as="geometry"/></mxCell><mxCell id="l4b_bg2" value="Deterministic gates decide; an optional reviewer model only adds findings for policy-selected risky changes. Failures are classified so each class goes to the right owner: local bugs back to the worker, size problems back to decomposition, contract mismatches to the Planner / Registry, infrastructure faults to infra retry. Integration mirrors the decomposition tree: a composite is integrated when all its children are verified, so repair stays local to one subtree." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="l4b_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#A3194B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="136.0" width="1564.0" height="1836.0" as="geometry"/></mxCell><mxCell id="l4b_bg4" value="Verification Gate · per leaf attempt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A3194B;strokeColor=#A3194B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="153.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l4b_bg5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#A3194B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="1992.0" width="1564.0" height="1292.0" as="geometry"/></mxCell><mxCell id="l4b_bg6" value="Integration &amp;amp; Repair · bottom-up over the task tree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A3194B;strokeColor=#A3194B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="2009.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l4b_bg7" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="3314.0" width="2252.0" height="92.0" as="geometry"/></mxCell><mxCell id="l4b_i21" value="&lt;b&gt;IN ◀ IF-21 ChangeSet&lt;/b&gt;&lt;br&gt;from M4 Coding Worker&lt;br&gt;Payload: diff ref, worktree, attempt n&lt;br&gt;Trigger: worker done" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4b_scope" value="Scope check: only allowed&lt;br&gt;files, no deleted / weakened&lt;br&gt;tests, no secrets in diff" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_sq" value="Scope OK?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="374.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4b_stat" value="⚙ Static gates: formatter,&lt;br&gt;linter, type checker, build" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_sel" value="Select tests: task acceptance&lt;br&gt;+ contract tests of touched&lt;br&gt;interfaces + impacted tests" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_run" value="⚙ Run selected tests in&lt;br&gt;sandbox (timeout, no network)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_pass" value="All gates pass?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="918.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4b_clsf" value="Classify failure: rules over&lt;br&gt;logs first; T1 only when&lt;br&gt;no rule matches" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_fc" value="Failure class?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="904.0" y="918.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4b_flk" value="FLAKY: rerun once;&lt;br&gt;quarantine if it&lt;br&gt;flips again" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_env" value="ENV / INFRA: fix env&lt;br&gt;or infra retry (≤3),&lt;br&gt;then HITL" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_rev" value="Risky change by policy?&lt;br&gt;(security paths, low&lt;br&gt;coverage, public API)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1054.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4b_rv" value="LLM · reviewer (other model&lt;br&gt;or T3): diff vs contract,&lt;br&gt;findings in schema" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1B2631;strokeColor=#F4D03F;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1067.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_rvq" value="Blocking findings?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="1190.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4b_mrg" value="⚙ Merge task branch into&lt;br&gt;parent integration branch" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1339.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_conf" value="Merge conflict?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1462.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4b_reb" value="⚙ Rebase on new base;&lt;br&gt;re-run gates (infra&lt;br&gt;retry, max 2)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1475.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_cm" value="[MEM] Commit; registry:&lt;br&gt;implemented signatures +&lt;br&gt;test status; task VERIFIED" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1607.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l4b_ev" value="Publish TaskVerified" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1747.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_pv" value="Policy violation:&lt;br&gt;revert worktree; LOCAL_BUG&lt;br&gt;with violation as evidence" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1883.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_vnote" value="&lt;b&gt;Failure classes → owner&lt;/b&gt;&lt;br&gt;LOCAL_BUG → Scheduler requeue (IF-21)&lt;br&gt;FLAKY → rerun once, then quarantine + note&lt;br&gt;ENV / INFRA → infra retry, then HITL&lt;br&gt;CONTRACT_MISMATCH → Planner / Registry&lt;br&gt;SPEC_TOO_LARGE → Decomposition re-split&lt;br&gt;POLICY_VIOLATION → treated as LOCAL_BUG" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1168.0" y="1326.0" width="464.0" height="360.0" as="geometry"/></mxCell><mxCell id="l4b_o_rq" value="&lt;b&gt;OUT ▶ IF-21 Requeue&lt;/b&gt;&lt;br&gt;to M4 Task Scheduler&lt;br&gt;Payload: LOCAL_BUG / FLAKY + evidence&lt;br&gt;Trigger: fixable failure" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4b_o10" value="&lt;b&gt;OUT ▶ IF-10 TaskOutcome&lt;/b&gt;&lt;br&gt;to M3 Decomposition / Planner&lt;br&gt;Payload: SPEC_TOO_LARGE or CONTRACT_MISMATCH&lt;br&gt;Trigger: non-local failure" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="513.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4b_o03" value="&lt;b&gt;OUT ▶ IF-03 DecisionRequest&lt;/b&gt;&lt;br&gt;to M5 Decision Broker&lt;br&gt;Payload: environment problem + options&lt;br&gt;Trigger: infra retries exhausted" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="921.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4b_o07u" value="&lt;b&gt;OUT ▶ IF-07 ContractUpdate&lt;/b&gt;&lt;br&gt;to M5 Module &amp;amp; Interface Registry&lt;br&gt;Payload: implemented signatures, test status&lt;br&gt;Trigger: task verified" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1601.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4b_o17" value="&lt;b&gt;OUT ▶ IF-17 TaskVerified&lt;/b&gt;&lt;br&gt;to M5 Event Stream → Scheduler, Decomp.&lt;br&gt;Payload: task_id, commit, contract versions&lt;br&gt;Trigger: verified" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1737.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4b_iv" value="TaskVerified for a child&lt;br&gt;of composite P" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#A3194B;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="2107.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4b_allc" value="All children of P&lt;br&gt;VERIFIED / INTEGRATED?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="2230.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4b_wt2" value="Wait for next&lt;br&gt;sibling event" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fon