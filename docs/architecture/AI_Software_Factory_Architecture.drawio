_rl"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5c_e44" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#117A65;strokeWidth=2.5;fontColor=#117A65;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=2 4;" edge="1" parent="1" source="l5c_rl" target="l5c_o17b"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5c_e45" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5c_cs" target="l5c_cal"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5c_e46" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5c_cal" target="l5c_mp"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5c_e47" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5c_mp" target="l5c_o20b"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l5d" name="12 · LLD5d Tools, Skills &amp; Context"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="2358" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l5d_bg1" value="LLD 5d · Module 5 Shared Services: Tools &amp;amp; Skills Registry, Tool Executor (sandbox) and Context &amp;amp; Memory Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2312.0" height="58.0" as="geometry"/></mxCell><mxCell id="l5d_bg2" value="Tools perform actions; skills are versioned instruction packages loaded on demand (metadata first, body only when selected) so they do not bloat every prompt. Permissions are enforced by the executor, not by prompts. The Context &amp;amp; Memory Service is the only component that assembles model context: it enforces token budgets and returns CONTEXT_OVERFLOW instead of silently truncating must-have items, which feeds decomposition." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5d_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="136.0" width="1564.0" height="1156.0" as="geometry"/></mxCell><mxCell id="l5d_bg4" value="Tools &amp;amp; Skills Registry + Tool Executor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B2C83;strokeColor=#5B2C83;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="153.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l5d_bg5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="1312.0" width="1564.0" height="884.0" as="geometry"/></mxCell><mxCell id="l5d_bg6" value="Context &amp;amp; Memory Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B2C83;strokeColor=#5B2C83;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="1329.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l5d_bg7" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="2226.0" width="2252.0" height="92.0" as="geometry"/></mxCell><mxCell id="l5d_i23" value="&lt;b&gt;IN ◀ IF-23 SkillLookup&lt;/b&gt;&lt;br&gt;from M2, M3, M4 agents&lt;br&gt;Payload: capability, role&lt;br&gt;Trigger: agent needs a procedure" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5d_mt" value="Match capability + role →&lt;br&gt;candidate manifests" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_any" value="Any candidate?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="238.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5d_none" value="Return none: caller&lt;br&gt;uses built-in template" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=3;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_rk" value="Rank: exact capability,&lt;br&gt;version pin, past&lt;br&gt;success rate" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_md" value="Return metadata only;&lt;br&gt;body loaded when the&lt;br&gt;agent selects it" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_o23" value="&lt;b&gt;OUT ▶ IF-23 SkillManifests&lt;/b&gt;&lt;br&gt;to calling agent&lt;br&gt;Payload: name, description, version, permissions&lt;br&gt;Trigger: lookup done" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5d_rg" value="Register or update&lt;br&gt;a skill / tool" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_vm" value="Validate manifest; pin&lt;br&gt;version; checksum" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_pm" value="Permissions within&lt;br&gt;policy?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="904.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5d_aa" value="Admin approves&lt;br&gt;new permission" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_sm" value="[MEM] Store versioned&lt;br&gt;manifest" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="519.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5d_i14" value="&lt;b&gt;IN ◀ IF-14 ToolInvocation&lt;/b&gt;&lt;br&gt;from M4 Worker, M2 Repo Intake, M4 Gate&lt;br&gt;Payload: tool, args, workspace id, role&lt;br&gt;Trigger: model or service requests a tool" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="921.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5d_va" value="Validate args vs&lt;br&gt;tool schema" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_pe" value="Permission? role allow-&lt;br&gt;list, path scope,&lt;br&gt;network, destructive" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="918.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5d_dn" value="Deny with reason&lt;br&gt;(fed back to model)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=3;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_ha" value="Approve tool use&lt;br&gt;(via Decision Broker)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1067.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_ex" value="⚙ Execute in sandbox:&lt;br&gt;workspace mount only, no&lt;br&gt;network, CPU/RAM/time caps" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_to" value="Timed out?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1168.0" y="918.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5d_kl" value="Kill process tree;&lt;br&gt;TIMEOUT result" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1067.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_ut" value="Output is untrusted data:&lt;br&gt;truncate, strip control&lt;br&gt;chars, provenance tag" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_lg" value="[MEM] Log usage&lt;br&gt;and result" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="927.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5d_o14" value="&lt;b&gt;OUT ▶ IF-14 ToolResult&lt;/b&gt;&lt;br&gt;to caller&lt;br&gt;Payload: exit code, output ref, duration&lt;br&gt;Trigger: tool finished" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="1057.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5d_i11" value="&lt;b&gt;IN ◀ IF-11 ContextRequest&lt;/b&gt;&lt;br&gt;from M2, M3 (sizer, planner), M4 (coder)&lt;br&gt;Payload: task id, role, token budget&lt;br&gt;Trigger: before any model call" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1417.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5d_p0" value="Collect must-have: P0 spec +&lt;br&gt;acceptance, P1 pinned&lt;br&gt;signatures, P2 allowed files" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1427.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_p3" value="Collect optional: P3 snippets&lt;br&gt;(symbols, lexical, optional&lt;br&gt;embeddings), P4, P5" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1427.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_tk" value="Count tokens with the&lt;br&gt;target model tokenizer" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="1427.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_fit" value="P0 + P1 + P2 fit&lt;br&gt;the budget?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1168.0" y="1414.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5d_ov" value="Return CONTEXT_OVERFLOW&lt;br&gt;with item sizes (never&lt;br&gt;truncate must-haves)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=3;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1563.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_gf" value="Greedy-fill P3–P5 by&lt;br&gt;relevance; optional T1&lt;br&gt;summaries if policy" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="1427.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_mf" value="[MEM] Persist ContextPack&lt;br&gt;manifest (items, hashes)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1423.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5d_o11" value="&lt;b&gt;OUT ▶ IF-11 ContextPack&lt;/b&gt;&lt;br&gt;to caller&lt;br&gt;Payload: pack id, items, token count&lt;br&gt;Trigger: pack built" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="1553.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5d_ms" value="Stage end, task verified&lt;br&gt;or decision logged" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_cq" value="Conversation over&lt;br&gt;compaction threshold?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="1686.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5d_sum" value="LLM · T1 summarise old&lt;br&gt;turns (lossy; source&lt;br&gt;refs kept)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1B2631;strokeColor=#F4D03F;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1835.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_dlg" value="[MEM] Update decision log&lt;br&gt;and project memory&lt;br&gt;(ADR-style, tagged)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="1695.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5d_inv" value="Invalidate memory and index&lt;br&gt;entries whose source&lt;br&gt;hash changed" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_rix" value="Re-index changed files&lt;br&gt;(symbols, imports,&lt;br&gt;test map)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_rel" value="Release task-scoped&lt;br&gt;caches" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5d_mt2" value="&lt;b&gt;Memory kinds (kept separate)&lt;/b&gt;&lt;br&gt;Model context — ephemeral, built per call by this service, budgeted&lt;br&gt;Conversation history — projection of the event log; compacted summaries&lt;br&gt;Project memory — decision log, assumptions, glossary; tagged, invalidated by source hash&lt;br&gt;Task state — State Store (transactional); never in prompts except the current spec&lt;br&gt;Source artifacts — VCS workspace + registry signatures; read via allowed files only&lt;br&gt;Execution logs — blobs referenced from events; only the newest failure is summarised into context" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="376.0" y="1958.0" width="1520.0" height="224.0" as="geometry"/></mxCell><mxCell id="l5d_e1" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5d_i23" target="l5d_mt"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5d_e2" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5d_mt" target="l5d_any"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5d_e3" value="no" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#C0392B;strokeWidth=2.5;fontColor=#C0392B;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="l5d_any" target="l5d_none"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5d_e4" value="yes" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;str