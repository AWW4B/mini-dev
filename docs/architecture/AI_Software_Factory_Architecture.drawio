ry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1268.0" y="1390.0"/><mxPoint x="1136.0" y="1390.0"/><mxPoint x="1136.0" y="1662.0"/><mxPoint x="1268.0" y="1662.0"/></Array></mxGeometry></mxCell><mxCell id="l1_e43" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l1_send" target="l1_o05"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l2" name="03 · LLD2 Request Processing"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="3398" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l2_bg1" value="LLD 2 · Module 2: Request Processing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2312.0" height="58.0" as="geometry"/></mxCell><mxCell id="l2_bg2" value="Deterministic first: type detection, extraction, quality checks, rule-based classification and checklists run without a model. A small local model (T1) structures the brief; a remote tier is used only when policy allows. All user, document and repository text is tagged with provenance and treated as untrusted data, never as instructions. NEW: Repository Intake for debug / feature / refactor requests." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="l2_bg3" valu