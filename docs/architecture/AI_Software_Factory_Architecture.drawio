tryDy=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="l4b_rr" target="l4b_esc"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l4b_e45" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l4b_esc" target="l4b_o10e"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l4b_e46" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l4b_prom" target="l4b_root"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l4b_e47" value="no" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l4b_root" target="l4b_up"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l4b_e48" value="yes" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l4b_root" target="l4b_o10c"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="476.0" y="3022.0"/><mxPoint x="344.0" y="3022.0"/><mxPoint x="344.0" y="3090.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l5a" name="09 · LLD5a Registry, State &amp; Workspace"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="2310" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l5a_bg1" value="LLD 5a · Module 5 Shared Services: Module &amp;amp; Interface Registry, Project State Store, Artifact &amp;amp; Workspace Store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2312.0" height="58.0" as="geometry"/></mxCell><mxCell id="l5a_bg2" value="Three stores with different jobs: the Registry holds versioned contracts (the &quot;stable boundary&quot; every task codes against); the State Store holds transactional operational state (runs, task graph, attempts, leases, decisions) and is the source of truth for recovery; the Artifact &amp;amp; Workspace Store holds source code under version control plus content-addressed blobs. Conversation history is not stored separately: it is a projection of the event log." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5a_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="136.0" width="1564.0" height="748.0" as="geometry"/></mxCell><mxCell id="l5a_bg4" value="Module &amp;amp; Interface Registry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B2C83;strokeColor=#5B2C83;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="153.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l5a_bg5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="904.0" width="1564.0" height="748.0" as="geometry"/></mxCell><mxCell id="l5a_bg6" value="Project State Store · operational state, outbox, recovery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B2C83;strokeColor=#5B2C83;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="921.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l5a_bg7" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="1672.0" width="1564.0" height="476.0" as="geometry"/></mxCell><mxCell id="l5a_bg8" value="Artifact &amp;amp; Workspace Store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B2C83;strokeColor=#5B2C83;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="1689.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l5a_bg9" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="2178.0" width="2252.0" height="92.0" as="geometry"/></mxCell><mxCell id="l5a_i07" value="&lt;b&gt;IN ◀ IF-07 ContractRegister / Update&lt;/b&gt;&lt;br&gt;from M3 Planner, Decomposition; M4 Gate&lt;br&gt;Payload: module, version, schema, signatures&lt;br&gt;Trigger: plan / split / verified task" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5a_val" value="Validate contract schema&lt;br&gt;(IDL / JSON Schema)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_vq" value="Valid?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="238.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5a_rej" value="Reject with reasons&lt;br&gt;(to caller)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=3;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_cmp" value="Compatibility vs latest:&lt;br&gt;added = minor; removed or&lt;br&gt;changed = breaking" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_brk" value="Breaking change?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5a_cons" value="VERIFIED consumers&lt;br&gt;exist?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="904.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5a_ap" value="Approve breaking change&lt;br&gt;(impacted tasks listed)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_st" value="[MEM] Store immutable version:&lt;br&gt;DRAFT / STABLE / DEPRECATED" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="655.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5a_imp" value="Mark impacted tasks for&lt;br&gt;re-verification (dependents&lt;br&gt;→ BLOCKED)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_ct" value="Generate / refresh&lt;br&gt;contract-test stubs" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_i08" value="&lt;b&gt;IN ◀ IF-08 ContractQuery&lt;/b&gt;&lt;br&gt;from M3 Context requests, M4 Worker&lt;br&gt;Payload: module@version or task id&lt;br&gt;Trigger: context build / verification" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5a_res" value="Resolve pinned versions →&lt;br&gt;signature-only view&lt;br&gt;(no implementation)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_ret" value="Return ContractSet" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_o17a" value="&lt;b&gt;OUT ▶ IF-17 ContractChanged event&lt;/b&gt;&lt;br&gt;to M5 Event Stream → M3, M4&lt;br&gt;Payload: module, version, impacted tasks&lt;br&gt;Trigger: version stored / breaking approved" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="649.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5a_o03" value="&lt;b&gt;OUT ▶ IF-03 DecisionRequest&lt;/b&gt;&lt;br&gt;to M5 Decision Broker&lt;br&gt;Payload: breaking change + impact&lt;br&gt;Trigger: consumers exist" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="513.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5a_i16" value="&lt;b&gt;IN ◀ IF-16 StateCommit&lt;/b&gt;&lt;br&gt;from all modules&lt;br&gt;Payload: entity, expected version, mutation&lt;br&gt;Trigger: any state transition" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1009.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5a_tx" value="Begin transaction" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1019.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_ver" value="Entity version&lt;br&gt;matches?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="1006.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5a_conf" value="Reject: caller reloads&lt;br&gt;and retries (≤ 3)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=3;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1155.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_ap2" value="Apply mutation + write&lt;br&gt;outbox event in the&lt;br&gt;same transaction" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="1019.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_cm" value="[MEM] Commit (WAL,&lt;br&gt;durable fsync)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1015.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5a_rel" value="Outbox relay: at-least-once;&lt;br&gt;consumers dedupe by&lt;br&gt;event_id" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="1019.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5a_o17" value="&lt;b&gt;OUT ▶ IF-17 EventPublish&lt;/b&gt;&lt;br&gt;to M5 Event Stream&lt;br&