0;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_ag" target="l5b_kp2"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5b_e27" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_kp2" target="l5b_ts"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5b_e28" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_ts" target="l5b_th"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5b_e29" value="no" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_th" target="l5b_snap"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5b_e30" value="yes" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#C0392B;strokeWidth=2.5;fontColor=#C0392B;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="l5b_th" target="l5b_adv"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5b_e31" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_snap" target="l5b_o19"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5b_e32" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_adv" target="l5b_o20"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5b_e33" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_adv" target="l5b_snap"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1400.0" y="1546.0"/><mxPoint x="1400.0" y="1478.0"/><mxPoint x="1532.0" y="1478.0"/></Array></mxGeometry></mxCell><mxCell id="l5b_e34" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_pr" target="l5b_rd2"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5b_e35" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l5b_rd2" target="l5b_ts"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="872.0" y="1682.0"/><mxPoint x="872.0" y="1478.0"/><mxPoint x="1004.0" y="1478.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l5c" name="11 · LLD5c Model Gateway &amp; Local Runtime"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="2630" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l5c_bg1" value="LLD 5c · Module 5 Shared Services: Model Gateway and Local Runtime &amp;amp; Resource Governor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2312.0" height="58.0" as="geometry"/></mxCell><mxCell id="l5c_bg2" value="Renamed from &quot;API Gateway&quot;: one gateway fronts every model call, local or remote, behind a uniform request schema, so providers and runtimes can be swapped without touching agents. Routing is policy-driven (local-first; remote tier only for roles and budgets that allow it). The Local Runtime is the only component that knows about VRAM; it hands out inference-slot leases (1 by default, 2 if calibration allows)." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5c_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="136.0" width="1564.0" height="1428.0" as="geometry"/></mxCell><mxCell id="l5c_bg4" value="Model Gateway · routing, budgets, retries, schema enforcement, usage accounting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B2C83;strokeColor=#5B2C83;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="153.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l5c_bg5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="1584.0" width="1564.0" height="884.0" as="geometry"/></mxCell><mxCell id="l5c_bg6" value="Local Runtime &amp;amp; Resource Governor · inference slots, model residency, calibration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B2C83;strokeColor=#5B2C83;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="1601.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l5c_bg7" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="2498.0" width="2252.0" height="92.0" as="geometry"/></mxCell><mxCell id="l5c_i12" value="&lt;b&gt;IN ◀ IF-12 InferenceRequest&lt;/b&gt;&lt;br&gt;from M2, M3, M4 agents&lt;br&gt;Payload: role, messages, JSON schema, tier policy, budget key&lt;br&gt;Trigger: any model call" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5c_rt" value="Resolve route: role → tier&lt;br&gt;(T1 / T2 local, T3 remote)&lt;br&gt;+ ordered fallback chain" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_bq" value="Budget / quota OK&lt;br&gt;for this route?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="374.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_nx" value="Another route&lt;br&gt;in the chain?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="374.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_dg" value="Degraded: notify&lt;br&gt;orchestrator; return&lt;br&gt;PROVIDER_UNAVAILABLE" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=3;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_lc" value="Local route?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_ci" value="Circuit open for&lt;br&gt;this provider?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="646.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_ad" value="Provider adapter: uniform →&lt;br&gt;provider API; key from OS&lt;br&gt;keychain, never in prompt" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_call" value="⚙ Call with timeout;&lt;br&gt;stream tokens" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_er" value="Error?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1054.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_rtq" value="429 / 5xx / timeout&lt;br&gt;and retries &amp;lt; 3?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="1054.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_bo" value="Backoff: exponential +&lt;br&gt;jitter; honour&lt;br&gt;Retry-After" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="1067.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_oc" value="Open circuit (cool-down);&lt;br&gt;non-retryable 4xx →&lt;br&gt;fail fast" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1203.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_sv" value="Output valid vs&lt;br&gt;JSON schema?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1190.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_ra" value="Re-ask with validator&lt;br&gt;errors (≤ 2), then&lt;br&gt;INVALID_OUTPUT" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1339.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_us" value="[MEM] Usage: tokens in / out,&lt;br&gt;latency, cost (price-table&lt;br&gt;version), MEASURED / EST." style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1335.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l5c_rr" value="Return result to caller" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1475.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_gnote" value="&lt;b&gt;Tiers (roles, not products)&lt;/b&gt;&lt;br&gt;T0 deterministic code — no model&lt;br&gt;T1 small local model: classify, summarise, rubric&lt;br&gt;T2 local coder: leaf implementation, tests&lt;br&gt;T3 remote planning tier: plan, split, hard diagnosis,&lt;br&gt;escalation, optional review&lt;br&gt;Fallback chain example: T3 → (T3 alt provider) →&lt;br&gt;T2 + mandatory human approval" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1168.0" y="510.0" width="728.0" height="360.0" as="geometry"/></mxCell><mxCell id="l5c_o12" value="&lt;b&gt;OUT ▶ IF-12 InferenceResult&lt;/b&gt;&lt;br&gt;to calling agent&lt;br&gt;Payload: content / structured output, usage&lt;br&gt;Trigger: call finished" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1465.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5c_o17" value="&lt;b&gt;OUT ▶ IF-17 Usage event&lt;/b&gt;&lt;br&gt;to M5 Event Stream → Metrics&lt;br&gt;Payload: tokens, latency, cost, route&lt;br&gt;Trigger: every call" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1329.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5c_o20" value="&lt;b&gt;OUT ▶ IF-20 ProviderStatus&lt;/b&gt;&lt;br&gt;to M3 Run Control (via Metrics)&lt;br&gt;Payload: provider down / budget out&lt;br&gt;Trigger: chain exhausted" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="377.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5c_i13" value="&lt;b&gt;IN ◀ IF-13 SlotLease&lt;/b&gt;&lt;br&gt;from M4 Scheduler; Model Gateway (local route)&lt;br&gt;Payload: model, ctx size, ttl, priority&lt;br&gt;Trigger: task selected / local call" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1689.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5c_pb" value="Read probe: free VRAM / RAM,&lt;br&gt;loaded model, active leases" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_sl" value="Active leases&lt;br&gt;&amp;lt; max_slots?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="1686.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_qu" value="Bounded priority queue;&lt;br&gt;notify on slot free" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1835.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_ml" value="Requested model&lt;br&gt;loaded?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="904.0" y="1686.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_fit" value="Weights + KV cache&lt;br&gt;fit at this ctx?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="904.0" y="1822.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_ev" value="Evict idle model; or&lt;br&gt;smaller ctx; or partial&lt;br&gt;CPU offload (policy)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1835.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_fit2" value="Fits now?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1168.0" y="1958.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_rj" value="Reject lease:&lt;br&gt;RESOURCE_UNAVAILABLE" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=3;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="1971.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_ld" value="Load model; keep warm&lt;br&gt;until idle timeout" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="1971.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_gr" value="Grant lease&lt;br&gt;(ttl, heartbeat)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_inf" value="⚙ Run inference;&lt;br&gt;stream; heartbeat" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_hb" value="Heartbeat lost or&lt;br&gt;ttl expired?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1696.0" y="1686.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l5c_rc" value="Reclaim slot; stop&lt;br&gt;generation; report&lt;br&gt;INTERRUPTED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1835.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_rl" value="Release: free KV cache;&lt;br&gt;publish slot-free" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#5B2C83;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1971.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l5c_o17b" value="&lt;b&gt;OUT ▶ IF-17 SlotFree / Interrupted&lt;/b&gt;&lt;br&gt;to M4 Scheduler (via Event Stream)&lt;br&gt;Payload: lease id, outcome&lt;br&gt;Trigger: lease ends" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="1961.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l5c_cs" value="Install, model change&lt;br&gt;or weekly" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="2243.0" width=