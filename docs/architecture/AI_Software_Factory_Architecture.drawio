ect History are projections of the Event Stream and the Project State Store, so a reload or a second device shows the same execution trace. All human decisions go through one Decision Inbox, backed by the durable Decision Broker in M5." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="l1_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1F5F8B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="136.0" width="772.0" height="884.0" as="geometry"/></mxCell><mxCell id="l1_bg4" value="Active Group Chat · execution trace (projection of the event log)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5F8B;strokeColor=#1F5F8B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="153.0" width="772.0" height="34.0" as="geometry"/></mxCell><mxCell id="l1_bg5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1F5F8B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1146.0" y="136.0" width="244.0" height="884.0" as="geometry"/></mxCell><mxCell id="l1_bg6" value="Decision Inbox (HITL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5F8B;strokeColor=#1F5F8B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1146.0" y="153.0" width="244.0" height="34.0" as="geometry"/></mxCell><mxCell id="l1_bg7" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1F5F8B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1410.0" y="136.0" width="508.0" height="884.0" as="geometry"/></mxCell><mxCell id="l1_bg8" value="Project History" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5F8B;strokeColor=#1F5F8B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1410.0" y="153.0" width="508.0" height="34.0" as="geometry"/></mxCell><mxCell id="l1_bg9" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1F5F8B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="1040.0" width="772.0" height="884.0" as="geometry"/></mxCell><mxCell id="l1_bg10" value="Project Input" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5F8B;strokeColor=#1F5F8B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="1057.0" width="772.0" height="34.0" as="geometry"/></mxCell><mxCell id="l1_bg11" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1F5F8B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1146.0" y="1040.0" width="772.0" height="884.0" as="geometry"/></mxCell><mxCell id="l1_bg12" value="Resource Dashboard &amp;amp; Run Controls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5F8B;strokeColor=#1F5F8B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1146.0" y="1057.0" width="772.0" height="34.0" as="geometry"/></mxCell><mxCell id="l1_bg13" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1954.0" width="2252.0" height="92.0" as="geometry"/></mxCell><mxCell id="l1_i18" value="&lt;b&gt;IN ◀ IF-18 EventSubscribe&lt;/b&gt;&lt;br&gt;from M5 Event Stream&lt;br&gt;Payload: ordered event batch + cursor&lt;br&gt;Trigger: new events or reconnect" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l1_rcv" value="Receive event batch&lt;br&gt;(ordered by per-run seq)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_gap" value="Sequence gap?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="374.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l1_rep" value="Request replay from&lt;br&gt;last acknowledged cursor" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_proj" value="Project into view-model:&lt;br&gt;run → task tree →&lt;br&gt;attempt → step" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_kind" value="Event kind?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="646.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l1_need" value="Needs a user&lt;br&gt;decision?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="646.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l1_msg" value="Agent message card:&lt;br&gt;agent, role, model tier,&lt;br&gt;tokens, latency" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_tool" value="Tool / state card: tool,&lt;br&gt;args summary, exit status,&lt;br&gt;task badges, durations" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_thr" value="Append to virtualised thread; expand on demand:&lt;br&gt;payload, ContextPack manifest, diff, test log" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="398.0" y="931.0" width="420.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_card" value="Render decision card:&lt;br&gt;question, options, default,&lt;br&gt;deadline, evidence links" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_dec" value="User answers, approves,&lt;br&gt;rejects or edits" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_ok" value="Answer valid&lt;br&gt;for kind?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1168.0" y="918.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l1_inote" value="&lt;b&gt;Card kinds&lt;/b&gt;&lt;br&gt;clarify · approve plan&lt;br&gt;breaking contract · tool&lt;br&gt;permission · budget raise&lt;br&gt;escalation · split manually&lt;br&gt;Expired cards show the&lt;br&gt;default the Broker applied" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1168.0" y="238.0" width="200.0" height="224.0" as="geometry"/></mxCell><mxCell id="l1_o04" value="&lt;b&gt;OUT ▶ IF-04 DecisionResolved&lt;/b&gt;&lt;br&gt;to M5 Decision Broker&lt;br&gt;Payload: decision_id, choice, text, user&lt;br&gt;Trigger: user submits a valid answer" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="513.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l1_hs" value="Open project list" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#1F5F8B;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_i24" value="&lt;b&gt;IN ◀ IF-24 HistoryQuery&lt;/b&gt;&lt;br&gt;from M5 Project State Store&lt;br&gt;Payload: projects, runs, status, cost&lt;br&gt;Trigger: list / reopen" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="377.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l1_lst" value="List projects and runs:&lt;br&gt;status, last activity, cost" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_reo" value="Reopen a run?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1432.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l1_tl" value="Load run timeline: event-log&lt;br&gt;projection + artifact index&lt;br&gt;(not raw prompts)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="655.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l1_st" value="Run state?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1432.0" y="782.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l1_res" value="Active / suspended:&lt;br&gt;offer Resume" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_rep2" value="Finished: report with deliverables,&lt;br&gt;traceability matrix, decision log" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1454.0" y="931.0" width="420.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_o05h" value="&lt;b&gt;OUT ▶ IF-05 RunControl (resume)&lt;/b&gt;&lt;br&gt;to M3 Main Orchestrator&lt;br&gt;Payload: run_id, command=resume&lt;br&gt;Trigger: user resumes a suspended run" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="649.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l1_is" value="User composes request:&lt;br&gt;text ± files ± repo path,&lt;br&gt;optional mode hint" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#1F5F8B;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1155.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_psel" value="Project selected?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1278.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l1_pnew" value="[MEM] Create project record&lt;br&gt;(id, title, created_at)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1287.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l1_chk" value="Client checks: type allow-list,&lt;br&gt;size and count limits" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1F5F8B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1427.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l1_val" value="Valid?" style="whiteSpac