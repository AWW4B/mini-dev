r node?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1432.0" y="1734.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="dec_tier" value="Higher tier not&lt;br&gt;yet tried?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1696.0" y="1734.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="dec_man" value="HITL: split manually,&lt;br&gt;accept larger leaf,&lt;br&gt;or abandon subtree" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1475.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_fb" value="Feed validator errors&lt;br&gt;back; attempt + 1" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="1611.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_commit" value="[MEM] Atomic commit: children,&lt;br&gt;edges, idempotency keys,&lt;br&gt;parent → DECOMPOSED" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1879.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="dec_push" value="Push children to&lt;br&gt;frontier (PROPOSED)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="2019.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_tests" value="Derive acceptance tests&lt;br&gt;from criteria (template,&lt;br&gt;T2 local if needed)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1475.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_dry" value="[CTX] Dry-run ContextPack&lt;br&gt;at leaf budget" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1607.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="dec_fitq" value="Must-have context&lt;br&gt;fits budget?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="1734.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="dec_cert" value="[MEM] Certify leaf: pinned&lt;br&gt;contract versions, allowed&lt;br&gt;files, tests, idem. key" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1879.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="dec_emit" value="Emit LeafTaskSpec&lt;br&gt;(scheduler holds it until&lt;br&gt;dependencies verified)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="2019.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_empty" value="Frontier empty?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="2142.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="dec_aud" value="Completeness audit: every&lt;br&gt;requirement → leaf test or&lt;br&gt;integration test" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="2291.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_rs" value="Attach failure evidence;&lt;br&gt;force split; resplit&lt;br&gt;budget − 1" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_note" value="&lt;b&gt;Termination guarantees (no fixed depth)&lt;/b&gt;&lt;br&gt;1  Size measure S(n) strictly decreases: every child ≤ α·S(parent), α = 0.8 (configurable)&lt;br&gt;2  Leaf threshold &amp;gt; 0, so every branch reaches a leaf or is rejected&lt;br&gt;3  Per node: ≤ 2 split attempts + 1 tier escalation, then HITL&lt;br&gt;4  Run budget: max nodes, planning tokens, API spend, wall-clock&lt;br&gt;5  Cycle check (topological sort) on every commit&lt;br&gt;6  Cancel / pause token checked every iteration&lt;br&gt;7  Depth over a soft threshold raises a review event only; it never stops expansion&lt;br&gt;8  Duplicate guard: idempotency key = hash(parent, normalised goal, contract slice)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="376.0" y="2414.0" width="1520.0" height="130.0" as="geometry"/></mxCell><mxCell id="dec_e1" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dec_in_plan" target="dec_s"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_e2" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dec_s" target="dec_seed"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_e3" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dec_seed" target="dec_pop"><mxGeometry x="0.0" relative="1" as