;html=1;fillColor=#B9590E;strokeColor=#B9590E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1146.0" y="1057.0" width="772.0" height="34.0" as="geometry"/></mxCell><mxCell id="l2_bg11" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#B9590E;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="2080.0" width="1564.0" height="1156.0" as="geometry"/></mxCell><mxCell id="l2_bg12" value="Request Understanding" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B9590E;strokeColor=#B9590E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="2097.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l2_bg13" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="3266.0" width="2252.0" height="92.0" as="geometry"/></mxCell><mxCell id="l2_i01" value="&lt;b&gt;IN ◀ IF-01 SubmitRequest&lt;/b&gt;&lt;br&gt;from M1 Project Input&lt;br&gt;Payload: text, attachment refs, repo_ref, hint&lt;br&gt;Trigger: user submits" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l2_rec" value="[MEM] Create request record;&lt;br&gt;idem. key = hash(project,&lt;br&gt;text, attachment hashes)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="247.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l2_dup" value="Duplicate&lt;br&gt;submission?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="374.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l2_ret" value="Return existing&lt;br&gt;request id" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=3;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_tag" value="Tag provenance: user text,&lt;br&gt;document text, repo text&lt;br&gt;(untrusted data)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#B9590E;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_fan" value="Fan-out intake branches&lt;br&gt;(docs and / or repo)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#B9590E;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_bar" value="Barrier: wait for all&lt;br&gt;branches (each bounded&lt;br&gt;by its own timeout)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#B9590E;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_rnote" value="&lt;b&gt;Branch rules&lt;/b&gt;&lt;br&gt;attachments → Document Ingestion&lt;br&gt;repo_ref → Repository Intake&lt;br&gt;neither → straight to&lt;br&gt;normalisation" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="640.0" y="646.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l2_typ" value="Detect type by magic&lt;br&gt;bytes: PDF, DOCX, MD,&lt;br&gt;TXT, other" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#B9590E;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_sup" value="Supported and within&lt;br&gt;size / page limits?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1168.0" y="374.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l2_txt" value="PDF without&lt;br&gt;text layer?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1168.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l2_ocr" value="⚙ OCR pass (optional&lt;br&gt;component, CPU)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_ext" value="⚙ Primary extractor → Markdown:&lt;br&gt;headings, lists, tables,&lt;br&gt;code blocks preserved" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_qa" value="Quality OK? text ratio,&lt;br&gt;headings, tables,&lt;br&gt;garbled-char rate" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1168.0" y="782.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l2_alt" value="⚙ Alternate extractor&lt;br&gt;(max 2 alternates)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1434.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_dh" value="Unsupported, oversized&lt;br&gt;or unreadable: convert,&lt;br&gt;split, paste or accept partial" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_idx" value="[MEM] Store original + .md +&lt;br&gt;section index (IDs, token&lt;br&gt;counts, REQ anchors)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="927.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l2_o03a" value="&lt;b&gt;OUT ▶ IF-03 DecisionRequest&lt;/b&gt;&lt;br&gt;to M5 Decision Broker&lt;br&gt;Payload: ingestion problem + options&lt;br&gt;Trigger: unsupported / extraction exhausted" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="377.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l2_acc" value="Repo reachable and&lt;br&gt;within size limit?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1142.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l2_rh" value="Ask for access, a&lt;br&gt;smaller scope or&lt;br&gt;excluded paths" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;fixedSize=0;fillColor=#FDEBD0;strokeColor=#D35400;strokeWidth=2.5;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1155.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_snapr" value="[MEM] Snapshot into managed&lt;br&gt;workspace; baseline commit" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1287.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l2_det" value="Detect languages, build&lt;br&gt;system, test commands&lt;br&gt;(deterministic heuristics)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#B9590E;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1427.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_ix" value="Static index: file tree,&lt;br&gt;symbols, import graph,&lt;br&gt;test ↔ source map" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#B9590E;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1563.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l2_cmd" value="Build / test&lt;br&gt;commands found?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1686.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l2_cmdq" value="LLM · T1 local proposes&lt;br&gt;commands; user confirms&lt;br&gt;(HITL) before first run" 