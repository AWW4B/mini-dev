;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dec_emit" target="dec_o_ready"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="872.0" y="2050.0"/><mxPoint x="872.0" y="1982.0"/><mxPoint x="1928.0" y="1982.0"/><mxPoint x="1928.0" y="2050.0"/></Array></mxGeometry></mxCell><mxCell id="dec_e42" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dec_commit" target="dec_o_reg"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_e43" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dec_aud" target="dec_o_orc"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_e44" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#117A65;strokeWidth=2.5;fontColor=#117A65;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=2 4;" edge="1" parent="1" source="dec_ckpt" target="dec_o_ev"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_e45" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dec_ctx" target="dec_o_ctx"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sm" name="06 · LLD3c Task Node Lifecycle"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2550" pageHeight="1206" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sm_bg1" value="LLD 3c · Task node lifecycle (state machine) and leaf-sizing model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2550.0" height="58.0" as="geometry"/></mxCell><mxCell id="sm_bg2" value="One persisted state per task node; every transition is a single transaction in the Project State Store plus one event. Composite nodes travel the top row, leaves the third row. Every loop is bounded by a counter stored on the node. Pause moves any non-terminal node to SUSPENDED and records the prior state; abort moves it to CANCELLED." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2430.0" height="70.0" as="geometry"/></mxCell><mxCell id="sm_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="130.0" width="1940.0" height="920.0" as="geometry"/></mxCell><mxCell id="sm_bg4" value="State machine · task node (composite and leaf)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7B45;strokeColor=#1E7B45;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30.0" y="153.0" width="1940.0" height="34.0" as="geometry"/></mxCell><mxCell id="sm_bg5" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1074.0" width="2490.0" height="92.0" as="geometry"/></mxCell><mxCell id="sm_prop" value="PROPOSED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72.0" y="260.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_size" value="SIZING" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352.0" y="260.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_spl" value="SPLITTING" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="632.0" y="260.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_decd" value="DECOMPOSED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="912.0" y="260.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_chd" value="CHILDREN_DONE" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1192.0" y="260.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_intg" value="INTEGRATING" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1472.0" y="260.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_intd" value="INTEGRATED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#1E7B45;strokeColor=#17202A;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1752.0" y="260.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_defr" value="DEFERRED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72.0" y="400.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_await" value="AWAITING_INPUT" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="632.0" y="400.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_rep" value="REPAIRING" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1472.0" y="400.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_leaf" value="LEAF_CERTIFIED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352.0" y="540.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_blk" value="BLOCKED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="632.0" y="540.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_rdy" value="READY" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="912.0" y="540.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_run" value="RUNNING" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1192.0" y="540.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_ver" value="VERIFYING" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1472.0" y="540.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_vd" value="VERIFIED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#1E7B45;strokeColor=#17202A;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1752.0" y="540.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_fa" value="FAILED_ATTEMPT" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1192.0" y="820.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_esc" value="ESCALATED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="632.0" y="820.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_ab" value="ABANDONED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#A3194B;strokeColor=#17202A;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72.0" y="820.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_sus" value="SUSPENDED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#F4F6F6;strokeColor=#4D5656;strokeWidth=2.5;fontColor=#17202A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72.0" y="960.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_cx" value="CANCELLED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=30;fillColor=#4D5656;strokeColor=#17202A;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352.0" y="960.0" width="176.0" height="60.0" as="geometry"/></mxCell><mxCell id="sm_snote" value="Any non-terminal state → SUSPENDED on pause / HITL timeout (prior state recorded; resume restores it). Any non-terminal state → CANCELLED on abort. RUNNING with an expired lease after a crash → READY (interruption counter + 1, max 3; no attempt charged)." style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620.0" y="953.0" width="1320.0" height="74.0" as="geometry"/></mxCell><mxCell id="sm_sizing" value="&lt;b&gt;Leaf-sizing model (deterministic, calibrated)&lt;/b&gt;&lt;br&gt;C_eff = largest context at which the local coder kept ≥ target pass rate in calibration (measured, not advertised)&lt;br&gt;est_in = spec + pinned signatures + allowed files + snippets + tool schemas&lt;br&gt;est_out ≈ k × (functions to write) + test code; k learnt per model&lt;br&gt;LEAF if est_in + est_out ≤ 0.6·C_eff AND files ≤ F_max (default 3) AND interfaces ≤ I_max (default 4) AND rubric risk ≤ R_max&lt;br&gt;Calibration table: success rate by size bucket per model; thresholds tighten if first-pass rate &amp;lt; target, relax slowly when above&lt;br&gt;S(n) = est_in + est_out (size measure used by the α-progress rule)" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2020.0" y="250.0" width="430.0" height="360.0" as="geometry"/></mxCell><mxCell id="sm_budg" value="&lt;b&gt;Default budgets (proposed, configurable)&lt;/b&gt;&lt;br&gt;worker attempts per leaf: 3 (then 1 higher-tier attempt if policy allows)&lt;br&gt;format / schema repair re-asks: 2 per call&lt;br&gt;split attempts per node: 2 + 1 tier escalation&lt;br&gt;resplits per node after execution failure: 1&lt;br&gt;integration repair rounds per composite: 2&lt;br&gt;clarification rounds per request: 3 · plan revisions: 3&lt;br&gt;infra retries (lease / runtime / merge): 3 · interruptions: 3&lt;br&gt;API retries: 3, exponential backoff + jitter, Retry-After honoured" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2020.0" y="670.0" width="430.0" height="360.0" as="geometry"/></mxCell><mxCell id="sm_e1" value="popped" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sm_prop" target="sm_size"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm_e2" value="lazy: later" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sm_prop" target="sm_defr"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm_e3" value="dep verified" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#7D3C98;strokeWidth=2.5;fontColor=#7D3C98;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.12;entryY=1;e