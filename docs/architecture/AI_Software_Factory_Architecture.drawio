xCell><mxCell id="idx_cr_10_0" value="C11" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="520.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_10_1" value="ABORT only cleared the queue" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="520.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_10_2" value="Scoped cancel signal reaching running inference; pause / resume semantics (04)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="520.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_11_0" value="C12" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="554.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_11_1" value="HLD hard-coded a provider and a runtime" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="554.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_11_2" value="Technology-neutral Model Gateway with tier roles and adapters (11)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="554.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_12_0" value="C13" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="588.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_12_1" value="Clarification duplicated across M2; answers never re-entered extraction" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="588.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_12_2" value="Single clarification loop in Request Understanding; answers merged and logged (03)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="588.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_13_0" value="C14" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="622.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_13_1" value="Only new / debug / feature task types" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="622.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_13_2" value="Adds refactor, test generation, code-level docs; unsupported types stop explicitly" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="622.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_14_0" value="C15" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="656.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_14_1" value="No boundary for untrusted documents, repository text or tool output" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="656.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_14_2" value="Provenance tags, executor-enforced permissions, sandbox, secrets outside prompts" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="656.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_15_0" value="C16" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="690.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_15_1" value="Dashboard mixed measured and estimated values; metrics changed concurrency directly" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="690.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_15_2" value="MEASURED / ESTIMATED tags; advisories via IF-20 to scheduler and run control" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="690.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_16_0" value="C17" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="724.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_16_1" value="Conversation, operational state and artifacts were stored together" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="724.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_16_2" value="State Store vs Artifact &amp;amp; Workspace Store; conversation = event-log projection" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="724.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_17_0" value="C18" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="758.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_17_1" value="Cross-module stubs were inconsistent between LLDs" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="758.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_17_2" value="Numbered interface catalog IF-01 … IF-24 used on both sides of every boundary (15)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="758.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_st_h0" value="Status" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#5B2C83;strokeColor=#5B2C83;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="1010.0" width="180.0" height="30.0" as="geometry"/></mxCell><mxCell id="idx_st_h1" value="Items" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#5B2C83;strokeColor=#5B2C83;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900.0" y="1010.0" width="1090.0" height="30.0" as="geometry"/></mxCell><mxCell id="idx_st_0_0" value="CONFIRMED (brief)" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="1040.0" width="180.0" height="40.8" as="geometry"/></mxCell><mxCell id="idx_st_0_1" value="16 GB RAM, RTX 4050 6 GB VRAM; one local coding inference in the worst case (two not guaranteed); external APIs optional and quota-limited; PDF / DOCX → Markdown; no fixed decomposition depth but bounded execution; no automatic deployment; open source, modular, provider-replaceable" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900.0" y="1040.0" width="1090.0" height="40.8" as="geometry"/></mxCell><mxCell id="idx_st_1_0" value="ASSUMED (review)" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="1080.8" width="180.0" height="40.8" as="geometry"/></mxCell><mxCell id="idx_st_1_1" value="A1 single user, single machine · A2 university-scale projects (tens of thousands of lines, not millions) · A3 one active run per machine · A4 v1 targets languages with mature test runners (Python, TypeScript) · A5 git available · A6 sandbox has no network by default; dependency installs are explicit approved steps" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900.0" y="1080.8" width="1090.0" height="40.8" as="geometry"/></mxCell><mxCell id="idx_st_2_0" value="OPEN (decide)" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="1121.7" width="180.0" height="40.8" as="geometry"/></mxCell><mxCell id="idx_st_2_1" value="D1 plan-approval policy (always, or only new builds / breaking changes) · D2 numeric budgets (α, attempts, 0.6·C_eff margin) set by benchmark · D3 reviewer model on by default? · D4 HITL deadline and safe-default per kind · D5 remote provider(s) and monthly spend cap · D6 Windows + WSL2 vs native Linux host · D7 v1 language list" style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900.0" y="1121.7" width="1090.0" height="40.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="hld" name="01 · HLD Module Architecture &amp; Workflows"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="2136" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hld_bg1" value="AI SOFTWARE FACTORY · High-Level Design: modules, interfaces and main workflows (revised)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2500.0" height="58.0" as="geometry"/></mxCell><mxCell id="hld_bg2" value="Same five groupings and module names as the original HLD (four functional zones + Shared Services &amp;amp; Persistence). Changes are marked NEW / CHANGED. Central capability: recursive, contract-driven, resource-aware decomposition, so large projects complete with ONE local coding inference at a time. Diagrams stay technology-neutral: model tiers (T1 small local, T2 local coder, T3 remote planning tier) are roles, not products." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2196.0" height="70.0" as="geometry"/></mxCell><mxCell id="hld_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1F5F8B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="133.0" width="548.0" height="608.0" as="geometry"/></mxCell><mxCell id="hld_bg4" value="1 · USER INTERFACE &amp;amp; INPUT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5F8B;strokeColor=#1F5F8B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="24.0" y="153.0" width="548.0" height="34.0" as="geometry"/></mxCell><mxCell id="hld_bg5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#B9590E;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="584.0" y="133.0" width="548.0" height="608.0" as="geometry"/></mxCell><mxCell id="hld_bg6" value="2 · REQUEST PROCESSING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B9590E;strokeColor=#B9590E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="584.0" y="153.0" width="548.0" height="34.0" as="geometry"/></mxCell><mxCell id="hld_bg7" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1144.0" y="133.0" width="548.0" height="608.0" as="geometry"/></mxCell><mxCell id="hld_bg8" value="3 · ORCHESTRATION &amp;amp; PLANNING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7B45;strokeColor=#1E7B45;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1144.0" y="153.0" width="548.0" height="34.0" as="geometry"/></mxCell><mxCell id="hld_bg9" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#A3194B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1704.0" y="133.0" width="548.0" height="608.0" as="geometry"/></mxCell><mxCell id="hld_bg10" value="4 · EXECUTION &amp;amp; VERIFICATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A3194B;strokeColor=#A3194B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1704.0" y="153.0" width="548.0" height="34.0" as="geometry"/></mxCell><mxCell id="hld_bg11" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="823.0" width="2228.0" height="430.0" as="geometry"/></mxCell><mxCell id="hld_bg12" value="5 · SHARED SERVICES &amp;amp; PERSISTENCE  (every module reaches these only through the numbered interfaces)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5B2C83;strokeColor=#5B2C83;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="24.0" y="843.0" width="2228.0" height="34.0" as="geometry"/></mxCell><mxCell id="hld_bg13" value="&lt;b&gt;MAIN WORKFLOWS&lt;/b&gt; (chip colour = owning module; red chips = failure handling)" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1296.0" width="1600.0" height="24.0" as="geometry"/></mxCell><mxCell id="hld_bg14" value="&lt;b&gt;FLOW 1 · New project build&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1336.0" width="900.0" height="20.0" as="geometry"/></mxCell><mxCell id="hld_bg15" value="&lt;b&gt;FLOW 2 · Debug existing project&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1430.0" width="900.0" height="20.0" as="geometry"/></mxCell><mxCell id="hld_bg16" value="&lt;b&gt;FLOW 3 · Add feature&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1524.0" width="900.0" height="20.0" as="geometry"/></mxCell><mxCell id="hld_bg17" value="&lt;b&gt;FLOW 4 · Refactor&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1618.0" width="900.0" height="20.0" as="geometry"/></mxCell><mxCell id="hld_bg18" value="&lt;b&gt;FLOW 5 · Task failure &amp;amp; recovery (bounded)&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1712.0" width="900.0" height="20.0" as="geometry"/></mxCell><mxCell id="hld_bg19" value="&lt;b&gt;FLOW 6 · Interruption &amp;amp; resume&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1806.0" width="900.0" height="20.0" as="geometry"/></mxCell><mxCell id="hld_bg20" value="&lt;b&gt;KEY DATA FLOWS &amp;amp; FEEDBACK LOOPS&lt;/b&gt;&lt;br&gt;→ Module contracts are the stable boundaries: tasks consume pinned signatures from the Registry, never another task's generation history&lt;br&gt;→ Verification failures go back by class: local bug → worker retry; too large → re-split; contract mismatch → Planner / Registry&lt;br&gt;→ Integration failures trigger targeted repair leaves inside one subtree (no full rebuild)&lt;br&gt;→ Every transition is a State Store transaction + event; the Group Chat, dashboard and recovery all read the same log" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="1900.0" width="1500.0" height="100.0" as="geometry"/></mxCell><mxCell id="hld_bg21" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="2004.0" width="2440.0" height="92.0" as="geometry"/></mxCell><mxCell id="hld_pi" value="&lt;b&gt;Project Input&lt;/b&gt;&lt;br&gt;• text, PDF / DOCX / MD, repo path&lt;br&gt;• client checks, upload (sha-256)&lt;br&gt;• emits IF-01 SubmitRequest" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1F5F8B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="240.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_gc" value="&lt;b&gt;Active Group Chat&lt;/b&gt;&lt;br&gt;• execution trace, not a transcript&lt;br&gt;• run → task → attempt → step&lt;br&gt;• tool calls, model tier, tokens&lt;br&gt;• projection of the event log" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1F5F8B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320.0" y="240.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_di" value="&lt;b&gt;Decision Inbox  · NEW&lt;/b&gt;&lt;br&gt;• one place for every HITL card&lt;br&gt;• clarify, approve, permission,&lt;br&gt;  budget, breaking change&lt;br&gt;• answers → IF-04" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1F5F8B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="418.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_ph" value="&lt;b&gt;Project History&lt;/b&gt;&lt;br&gt;• projects, runs, timelines&lt;br&gt;• reports + decision log&lt;br&gt;• resume suspended runs" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1F5F8B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320.0" y="418.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_rd" value="&lt;b&gt;Resource Dashboard &amp;amp; Run Controls&lt;/b&gt;&lt;br&gt;• tokens, API calls, cost, RAM / VRAM, queue, retries&lt;br&gt;• every value tagged MEASURED or ESTIMATED&lt;br&gt;• pause · resume · abort · cancel task → IF-05" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1F5F8B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="596.0" width="516.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_ir" value="&lt;b&gt;Intake Router  · NEW&lt;/b&gt;&lt;br&gt;• idempotent request record&lt;br&gt;• provenance tags (untrusted)&lt;br&gt;• fan-out docs / repo, barrier" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B9590E;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600.0" y="240.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_dg" value="&lt;b&gt;Document Ingestion&lt;/b&gt;&lt;br&gt;• type detection, OCR (opt.)&lt;br&gt;• extract → Markdown&lt;br&gt;• quality check, 2 alternates&lt;br&gt;• section index, REQ anchors" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B9590E;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="880.0" y="240.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_ri" value="&lt;b&gt;Repository Intake  · NEW&lt;/b&gt;&lt;br&gt;• snapshot to workspace&lt;br&gt;• build / test detection&lt;br&gt;• static index, baseline tests&lt;br&gt;• RepoProfile" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B9590E;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600.0" y="418.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_po" value="&lt;b&gt;Prompt Normalisation &amp;amp; Optimisation&lt;/b&gt;&lt;br&gt;• deterministic first&lt;br&gt;• T1 structuring + schema&lt;br&gt;• map-reduce for big docs&lt;br&gt;• traceability of REQ anchors" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B9590E;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="880.0" y="418.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_ru" value="&lt;b&gt;Request Understanding&lt;/b&gt;&lt;br&gt;• task type: rules first, T1 only on conflict (new / debug / feature / refactor / ...)&lt;br&gt;• checklist + contradiction check · ≤ 3 clarify rounds · assumptions logged&lt;br&gt;• emits IF-02 StructuredRequest" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B9590E;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600.0" y="596.0" width="516.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_mo" value="&lt;b&gt;Main Orchestrator&lt;/b&gt;&lt;br&gt;• durable run state machine&lt;br&gt;• routes by task type&lt;br&gt;• completeness + final&lt;br&gt;  acceptance; no auto-deploy" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1E7B45;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1160.0" y="240.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_pa" value="&lt;b&gt;Planning Agent&lt;/b&gt;&lt;br&gt;• T3 tier (degraded: T2 + HITL)&lt;br&gt;• modes: design, diagnosis,&lt;br&gt;  impact, refactor&lt;br&gt;• contracts DRAFT, approval" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1E7B45;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1440.0" y="240.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_rde" value="&lt;b&gt;Recursive Decomposition Engine  · CORE, REDESIGNED&lt;/b&gt;&lt;br&gt;• persisted frontier, one node per iteration, lazy expansion&lt;br&gt;• deterministic sizing vs measured profile; T3 splits&lt;br&gt;• validator: coverage, contracts, DAG, α-progress, dedupe&lt;br&gt;• no fixed depth; strict termination guarantees" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1E7B45;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1160.0" y="418.0" width="516.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_rc" value="&lt;b&gt;Run Control  · NEW&lt;/b&gt;&lt;br&gt;• pause / resume / abort&lt;br&gt;• cancel signal with scope&lt;br&gt;• resource advisories" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1E7B45;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1160.0" y="596.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_er" value="&lt;b&gt;Escalation &amp;amp; Recovery&lt;/b&gt;&lt;br&gt;• classifies escalations&lt;br&gt;• re-plan subtree (≤ 2)&lt;br&gt;• HITL with safe default" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1E7B45;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1440.0" y="596.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_tq" value="&lt;b&gt;Task Scheduler&lt;/b&gt;&lt;br&gt;• dependency-aware queue&lt;br&gt;• slot leases (1–2), model&lt;br&gt;  affinity, critical path&lt;br&gt;• attempt budget 3" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A3194B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1720.0" y="240.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_cw" value="&lt;b&gt;Local Coding Worker&lt;/b&gt;&lt;br&gt;• T2 local coder, bounded&lt;br&gt;  tool loop (≤ 12 turns)&lt;br&gt;• isolated worktree / branch&lt;br&gt;• scoped ContextPack only" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A3194B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2000.0" y="240.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_vg" value="&lt;b&gt;Verification Gate&lt;/b&gt;&lt;br&gt;• deterministic gates first&lt;br&gt;• selected tests in sandbox&lt;br&gt;• failure classes → owner&lt;br&gt;• optional reviewer model" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A3194B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1720.0" y="418.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_in" value="&lt;b&gt;Integration &amp;amp; Repair&lt;/b&gt;&lt;br&gt;• bottom-up per composite&lt;br&gt;• contract + E2E tests&lt;br&gt;• targeted repair leaf (≤ 2)&lt;br&gt;• no full rebuilds" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A3194B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2000.0" y="418.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_ws" value="&lt;b&gt;Change discipline  · CHANGED&lt;/b&gt;: work happens in a per-attempt branch; nothing is merged or registered before the gate passes; dependents consume pinned contract signatures, never the producer's generation history" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#A3194B;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1720.0" y="596.0" width="516.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_reg" value="&lt;b&gt;Module &amp;amp; Interface Registry&lt;/b&gt;&lt;br&gt;• versioned contracts&lt;br&gt;• compatibility / breaking&lt;br&gt;• signature-only views" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="930.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_pss" value="&lt;b&gt;Project State Store&lt;/b&gt;&lt;br&gt;• runs, task graph, attempts&lt;br&gt;• transactions + outbox&lt;br&gt;• crash reconciliation" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320.0" y="930.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_aws" value="&lt;b&gt;Artifact &amp;amp; Workspace Store  · NEW&lt;/b&gt;&lt;br&gt;• VCS repo per project&lt;br&gt;• branch / worktree ops&lt;br&gt;• content-addressed blobs" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600.0" y="930.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_evs" value="&lt;b&gt;Event Stream&lt;/b&gt;&lt;br&gt;• append-only, seq per run&lt;br&gt;• fan-out + replay&lt;br&gt;• single execution trace" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="880.0" y="930.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_dbk" value="&lt;b&gt;Decision Broker  · NEW&lt;/b&gt;&lt;br&gt;• durable HITL requests&lt;br&gt;• deadlines, safe defaults&lt;br&gt;• decision log" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1160.0" y="930.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_mtr" value="&lt;b&gt;Metrics &amp;amp; Monitoring&lt;/b&gt;&lt;br&gt;• usage, KPIs, probes&lt;br&gt;• measured vs estimated&lt;br&gt;• advisories (IF-20)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1440.0" y="930.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_mgw" value="&lt;b&gt;Model Gateway  · was API Gateway&lt;/b&gt;&lt;br&gt;• one door for all models&lt;br&gt;• tier routing, fallback&lt;br&gt;• retries, schema, usage" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1720.0" y="930.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_lrt" value="&lt;b&gt;Local Runtime &amp;amp; Resource Governor&lt;/b&gt;&lt;br&gt;• inference-slot leases&lt;br&gt;• VRAM residency&lt;br&gt;• calibration → ModelProfile" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2000.0" y="930.0" width="236.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_tsr" value="&lt;b&gt;Tools &amp;amp; Skills Registry + Tool Executor&lt;/b&gt;&lt;br&gt;• manifests, versions, permissions&lt;br&gt;• progressive skill loading&lt;br&gt;• sandboxed execution, timeouts" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1108.0" width="516.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_cms" value="&lt;b&gt;Context &amp;amp; Memory Service  · moved from M3&lt;/b&gt;&lt;br&gt;• builds every ContextPack under a token budget&lt;br&gt;• CONTEXT_OVERFLOW instead of silent truncation&lt;br&gt;• compaction, decision log, invalidation by hash" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#5B2C83;strokeWidth=2;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600.0" y="1108.0" width="516.0" height="124.0" as="geometry"/></mxCell><mxCell id="hld_bus" value="&lt;b&gt;Shared-service interfaces used by M1–M4&lt;/b&gt;&lt;br&gt;IF-03/04 decisions · IF-0