ry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="580.0" y="850.0"/><mxPoint x="580.0" y="780.0"/><mxPoint x="300.0" y="780.0"/><mxPoint x="300.0" y="850.0"/></Array></mxGeometry></mxCell><mxCell id="sm_e27" value="re-planned / budget added" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#7D3C98;strokeWidth=2.5;fontColor=#7D3C98;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="sm_esc" target="sm_blk"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="720.0" y="780.0"/><mxPoint x="580.0" y="780.0"/><mxPoint x="580.0" y="640.0"/><mxPoint x="720.0" y="640.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l4a" name="07 · LLD4a Scheduler &amp; Coding Worker"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="3310" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l4a_bg1" value="LLD 4a · Module 4: Task Scheduler and Local Coding Worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2312.0" height="58.0" as="geometry"/></mxCell><mxCell id="l4a_bg2" value="The scheduler owns task readiness and ordering; the Local Runtime (M5) owns inference slots. A task runs only while it holds a slot lease, so one or two concurrent local inferences is a runtime setting, not a design assumption. Each attempt works in an isolated branch / worktree created from the parent integration branch; nothing is registered or merged before the Verification Gate passes." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="l4a_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#A3194B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="136.0" width="1564.0" height="1428.0" as="geometry"/></mxCell><mxCell id="l4a_bg4" value="Task Scheduler · dependency-aware, resource-aware, model-affinity ordering" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A3194B;strokeColor=#A3194B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="153.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l4a_bg5" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#A3194B;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="1584.0" width="1564.0" height="1564.0" as="geometry"/></mxCell><mxCell id="l4a_bg6" value="Local Coding Worker · bounded tool loop in an isolated workspace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A3194B;strokeColor=#A3194B;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="1601.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="l4a_bg7" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Rounded solid box = deterministic step · Dark box with gold border = model (LLM) call, tier shown · Teal box = tool / sandbox action · Diamond = decision · Orange hexagon = human-in-the-loop (HITL) · Cylinder = memory / persistence / context operation · White pill = start / end · Red pill = stop / terminal failure · Grey dashed box = cross-module interface port (IN ◀ / OUT ▶ with interface ID)&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;Dark solid = control flow · Thick blue = cross-module data payload · Dashed purple = recursion / loop-back · Dashed red = retry, failure or escalation · Green dotted = event published to the Event Stream" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1B2631;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="3178.0" width="2252.0" height="92.0" as="geometry"/></mxCell><mxCell id="l4a_i09" value="&lt;b&gt;IN ◀ IF-09 ReadyTask&lt;/b&gt;&lt;br&gt;from M3 Recursive Decomposition&lt;br&gt;Payload: LeafTaskSpec&lt;br&gt;Trigger: leaf certified" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4a_enq" value="[MEM] Upsert task by&lt;br&gt;idempotency key (no&lt;br&gt;duplicate enqueue)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="247.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l4a_deps" value="All dependencies&lt;br&gt;VERIFIED?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="374.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_hold" value="Hold as BLOCKED;&lt;br&gt;re-check on&lt;br&gt;TaskVerified event" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_i17" value="&lt;b&gt;IN ◀ IF-17 TaskVerified / Integrated&lt;/b&gt;&lt;br&gt;from M5 Event Stream&lt;br&gt;Payload: task_id, new contract versions&lt;br&gt;Trigger: dependency finished" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="513.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4a_rank" value="Rank ready set: critical&lt;br&gt;path, unblocks-count,&lt;br&gt;model affinity, age" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_gate" value="Run paused or&lt;br&gt;budget exhausted?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="646.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_wait" value="Hold dispatch until&lt;br&gt;resume / budget event" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_lease" value="Request slot lease&lt;br&gt;(model, ctx size, ttl)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="795.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_lq" value="Lease granted?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="918.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_lw" value="Wait for slot-free event&lt;br&gt;(bounded queue; no&lt;br&gt;busy polling)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_mark" value="[MEM] Mark RUNNING:&lt;br&gt;attempt n, lease id,&lt;br&gt;base commit" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1063.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l4a_disp" value="Dispatch to Coding Worker" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1203.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_i_rq" value="&lt;b&gt;IN ◀ IF-21 Requeue&lt;/b&gt;&lt;br&gt;from M4 Verification Gate&lt;br&gt;Payload: LOCAL_BUG / FLAKY + evidence&lt;br&gt;Trigger: gate failed (fixable)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1329.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4a_rq" value="Attempts &amp;lt; 3?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1326.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_rqe" value="[MEM] READY again; store&lt;br&gt;only latest compacted&lt;br&gt;failure evidence" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1335.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l4a_ex" value="Escalate: TaskOutcome&lt;br&gt;ESCALATED + evidence" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1475.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_o10" value="&lt;b&gt;OUT ▶ IF-10 TaskOutcome&lt;/b&gt;&lt;br&gt;to M3 Orchestrator (escalation)&lt;br&gt;Payload: ESCALATED, class, evidence, attempts&lt;br&gt;Trigger: attempt budget exhausted" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1465.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4a_i06" value="&lt;b&gt;IN ◀ IF-06 CancelSignal / RunFlag&lt;/b&gt;&lt;br&gt;from M3 Run Control&lt;br&gt;Payload: scope, command&lt;br&gt;Trigger: pause / abort / cancel" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4a_cx" value="Revoke leases in scope;&lt;br&gt;signal worker; tasks →&lt;br&gt;CANCELLED / SUSPENDED" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_i20" value="&lt;b&gt;IN ◀ IF-20 ResourceAdvisory&lt;/b&gt;&lt;br&gt;from M5 Metrics / Local Runtime&lt;br&gt;Payload: max_slots (1 or 2), pressure&lt;br&gt;Trigger: calibration / pressure change" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="513.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4a_cap" value="Set dispatch cap =&lt;br&gt;max_slots; prefer tasks&lt;br&gt;for the loaded model" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1698.0" y="523.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_o13" value="&lt;b&gt;OUT ▶ IF-13 SlotLease&lt;/b&gt;&lt;br&gt;to M5 Local Runtime&lt;br&gt;Payload: model, ctx size, ttl, priority&lt;br&gt;Trigger: task selected" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="785.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4a_o17" value="&lt;b&gt;OUT ▶ IF-17 EventPublish&lt;/b&gt;&lt;br&gt;to M5 Event Stream&lt;br&gt;Payload: TaskStarted / Requeued / Escalated&lt;br&gt;Trigger: every transition" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="1057.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="l4a_ws" value="Task + lease received" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#A3194B;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1699.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_cp" value="[CTX] Request ContextPack:&lt;br&gt;spec, pinned signatures,&lt;br&gt;allowed files, latest failure" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="1831.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="l4a_ovf" value="Context overflow&lt;br&gt;reported?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="1958.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_wt" value="⚙ Create task worktree /&lt;br&gt;branch from parent&lt;br&gt;integration commit" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="2107.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_step" value="LLM · T2 local coder: next&lt;br&gt;step (plan, edit or tool&lt;br&gt;call) in schema" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1B2631;strokeColor=#F4D03F;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="2243.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_wf" value="Well-formed and&lt;br&gt;policy-allowed?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="2366.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_fix" value="Return error to model&lt;br&gt;(format repair ≤ 2&lt;br&gt;per step)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="2379.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_tc" value="⚙ Execute tool via Tool&lt;br&gt;Executor: read / edit /&lt;br&gt;search / run tests / lint" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="2515.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_done" value="Model signals done or&lt;br&gt;step budget spent?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="2638.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_fast" value="⚙ Fast checks: format,&lt;br&gt;lint, type, compile" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="2787.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_blkd" value="Model reports BLOCKED&lt;br&gt;(missing context or&lt;br&gt;contract gap)?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="2774.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_cs" value="⚙ Produce change set:&lt;br&gt;diff, files touched,&lt;br&gt;self-report" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#E8F6F3;strokeColor=#117A65;strokeWidth=2.5;fontColor=#0B5345;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="2923.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_out" value="Change set → Verification&lt;br&gt;Gate (same lease released)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="3059.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_inf" value="Inference timeout or&lt;br&gt;runtime unavailable?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="904.0" y="2230.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="l4a_infr" value="Release lease; requeue&lt;br&gt;without attempt charge&lt;br&gt;(infra retries ≤ 3)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#A3194B;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="2243.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="l4a_wnote" value="&lt;b&gt;Worker step budget (per attempt)&lt;/b&gt;&lt;br&gt;max turns: 12 · max output tokens per turn&lt;br&gt;wall-clock limit · tool timeout per call&lt;br&gt;Writes outside allowed files are denied by&lt;br&gt;the Tool Executor, not by the prompt&lt;br&gt;Only the newest failure evidence is in context&lt;br&gt;(older attempts summarised to one line)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontColor=#17202A;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="904.0" y="1686.0" width="728.0" height="224.0" as="geometry"/></mxCell><mxCell id="l4a_o11" value="&lt;b&gt;OUT ▶ IF-11 ContextRequest&lt;/b&gt;&lt;br&gt;to M5 Context &amp;amp; Memory Service&lt;br&gt;Payload: task_id, role=coder, budget&lt;br&gt;Trigger: attempt start" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" v