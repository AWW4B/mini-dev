X=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l3a_ok" target="l3a_reg"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3a_e54" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l3a_reg" target="l3a_o07"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3a_e55" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l3a_reg" target="l3a_appr"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3a_e56" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l3a_appr" target="l3a_aq"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3a_e57" value="reject" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#C0392B;strokeWidth=2.5;fontColor=#C0392B;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="l3a_appr" target="l3a_rej"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3a_e58" value="yes" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#2C3E50;strokeWidth=2.5;fontColor=#2C3E50;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l3a_aq" target="l3a_emit"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3a_e59" value="" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#1F77B4;strokeWidth=3.5;fontColor=#1F77B4;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="l3a_emit" target="l3a_o07a"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3a_e60" value="revise (≤3)" style="html=1;rounded=1;arcSize=8;endArrow=block;endFill=1;endSize=8;strokeColor=#7D3C98;strokeWidth=2.5;fontColor=#7D3C98;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="l3a_aq" target="l3a_llm"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="344.0" y="2682.0"/><mxPoint x="344.0" y="1850.5"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="dec" name="05 · LLD3b Recursive Decomposition"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="2624" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dec_bg1" value="LLD 3b · Recursive Decomposition Engine (core capability of Module 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17202A;strokeColor=none;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="2312.0" height="58.0" as="geometry"/></mxCell><mxCell id="dec_bg2" value="Persisted work-list algorithm. Each iteration sizes ONE node deterministically against the measured profile of the local coder, then either certifies it as a leaf or asks a planning-tier model to split it. No fixed depth limit: termination comes from a strictly decreasing size measure, per-node split budgets, a run-level node/token budget, cycle checks and the cancel token. Decomposition is lazy: contracts are fixed top-down first, deeper subtrees are expanded when they approach readiness so they can use already-implemented interfaces." style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontSize=12;fontColor=#34495E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="22.0" y="66.0" width="2192.0" height="70.0" as="geometry"/></mxCell><mxCell id="dec_bg3" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#1E7B45;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="354.0" y="136.0" width="1564.0" height="2244.0" as="geometry"/></mxCell><mxCell id="dec_bg4" value="Recursive Decomposition Engine · persisted frontier (priority work-list) · one node per iteration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7B45;strokeColor=#1E7B45;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="354.0" y="153.0" width="1564.0" height="34.0" as="geometry"/></mxCell><mxCell id="dec_in_plan" value="&lt;b&gt;IN ◀ IF-07a ApprovedPlan&lt;/b&gt;&lt;br&gt;from M3 Planning Agent&lt;br&gt;Payload: root + module nodes, DRAFT contracts&lt;br&gt;Trigger: plan approved" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="241.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_in_out" value="&lt;b&gt;IN ◀ IF-10 TaskOutcome&lt;/b&gt;&lt;br&gt;from M4 Verification / Worker&lt;br&gt;Payload: class SPEC_TOO_LARGE | CONTEXT_OVERFLOW + evidence&lt;br&gt;Trigger: leaf failed for size reasons" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="785.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_in_dep" value="&lt;b&gt;IN ◀ IF-17 TaskVerified event&lt;/b&gt;&lt;br&gt;from M5 Event Stream&lt;br&gt;Payload: task_id, contract versions now implemented&lt;br&gt;Trigger: dependency verified (lazy expansion)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="513.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_in_ans" value="&lt;b&gt;IN ◀ IF-04 DecisionResolved&lt;/b&gt;&lt;br&gt;from M5 Decision Broker&lt;br&gt;Payload: answer / manual split / waiver&lt;br&gt;Trigger: user resolved a split question" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1329.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_o_ready" value="&lt;b&gt;OUT ▶ IF-09 ReadyTask&lt;/b&gt;&lt;br&gt;to M4 Task Scheduler&lt;br&gt;Payload: LeafTaskSpec (pinned contracts, files, tests, budget)&lt;br&gt;Trigger: leaf certified; deps may be pending" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="2009.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_o_hitl" value="&lt;b&gt;OUT ▶ IF-03 DecisionRequest&lt;/b&gt;&lt;br&gt;to M5 Decision Broker → M1&lt;br&gt;Payload: question, options, evidence, default=suspend subtree&lt;br&gt;Trigger: ambiguity or split infeasible" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="1329.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_o_ctx" value="&lt;b&gt;OUT ▶ IF-11 ContextRequest&lt;/b&gt;&lt;br&gt;to M5 Context &amp;amp; Memory Service&lt;br&gt;Payload: node id, role=sizer, budget&lt;br&gt;Trigger: every sizing / leaf dry-run" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="785.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_o_reg" value="&lt;b&gt;OUT ▶ IF-07 ContractRegister&lt;/b&gt;&lt;br&gt;to M5 Module &amp;amp; Interface Registry&lt;br&gt;Payload: child contract slices (DRAFT)&lt;br&gt;Trigger: split committed" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="1873.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_o_orc" value="&lt;b&gt;OUT ▶ IF-10b DecompositionReport&lt;/b&gt;&lt;br&gt;to M3 Main Orchestrator&lt;br&gt;Payload: completeness audit, suspended nodes&lt;br&gt;Trigger: frontier empty or suspended" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="2281.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_o_ev" value="&lt;b&gt;OUT ▶ IF-17 EventPublish&lt;/b&gt;&lt;br&gt;to M5 Event Stream&lt;br&gt;Payload: NodeSized / Split / LeafCertified / Suspended&lt;br&gt;Trigger: every state transition" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=6;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#17202A;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1960.0" y="513.0" width="272.0" height="82.0" as="geometry"/></mxCell><mxCell id="dec_s" value="Approved plan root&lt;br&gt;(module nodes, contracts)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#1E7B45;strokeWidth=3;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="378.0" y="251.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_seed" value="[MEM] Seed persisted&lt;br&gt;frontier · state PROPOSED" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="247.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="dec_pop" value="Pop highest-priority node&lt;br&gt;(critical path, deps-ready,&lt;br&gt;unblocks-most first)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="387.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_cxl" value="Cancel / pause flag or&lt;br&gt;run budget exhausted?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="510.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="dec_ckpt" value="[MEM] Checkpoint frontier;&lt;br&gt;node → SUSPENDED" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="519.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="dec_lazy" value="Expand now?&lt;br&gt;(lazy policy)" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="646.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="dec_park" value="Park node DEFERRED;&lt;br&gt;wake on dependency&lt;br&gt;verified event" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="906.0" y="659.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_ctx" value="[CTX] Sizing context: spec,&lt;br&gt;parent contract, dep&lt;br&gt;signatures, candidate files" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBDEF0;strokeColor=#6C3483;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="791.0" width="196.0" height="70.0" as="geometry"/></mxCell><mxCell id="dec_est" value="Deterministic estimate:&lt;br&gt;prompt + output tokens, files,&lt;br&gt;interfaces, criteria count" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="931.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_rub" value="LLM · T1 local (small)&lt;br&gt;rubric: ambiguity +&lt;br&gt;coupling score (JSON)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1B2631;strokeColor=#F4D03F;strokeWidth=3;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1067.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_fit" value="Fit test vs ModelProfile:&lt;br&gt;tokens ≤ 0.6·C_eff, files ≤ F,&lt;br&gt;ifaces ≤ I, risk ≤ R, history" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#1E7B45;strokeColor=#1B2631;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642.0" y="1203.0" width="196.0" height="62.0" as="geometry"/></mxCell><mxCell id="dec_leafq" value="Fits leaf profile?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3B0;strokeColor=#9A7D0A;strokeWidth=2;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="1326.0" width="200.0" height="88.0" as="geometry"/></mxCell><mxCell id="dec_amb" value="Spec ambiguous or&lt;br&gt;contradictory?" style="whiteSpace=wrap;html=1;fontSize=10;align=center;verticalA