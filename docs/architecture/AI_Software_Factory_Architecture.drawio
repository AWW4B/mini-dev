ren carry contract slices; atomic commit of children + contracts; persisted frontier; idempotency keys" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="214.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_2_0" value="C3" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="248.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_2_1" value="Debug / feature skipped planning and nothing loaded an existing repository" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="770.0" y="248.0" width="560.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_2_2" value="Repository Intake (03) and Planner modes DIAGNOSIS, IMPACT, REFACTOR (04)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="248.0" width="660.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_3_0" value="C4" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="282.0" width="50.0" height="34.0" as="geometry"/></mxCell><mxCell id="idx_cr_3_1" valu