, size_estimate S(n), depth&lt;br&gt;• counters: split_attempts, resplits, attempts, interruptions, repair_rounds&lt;br&gt;• idempotency_key = hash(parent, normalised goal, contract slice)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="180.0" width="440.0" height="180.0" as="geometry"/></mxCell><mxCell id="ct_e1h" value="LeafTaskSpec (IF-09)" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#1E7B45;strokeColor=#1E7B45;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="484.0" y="150.0" width="440.0" height="30.0" as="geometry"/></mxCell><mxCell id="ct_e1b" value="• task_id, goal, acceptance tests (refs)&lt;br&gt;• pinned contracts (module@version, signature view)&lt;br&gt;• allowed_files[], read_only_files[]&lt;br&gt;• context budget (tokens), model role T2&lt;br&gt;• step budget (turns, tokens, wall-clock)&lt;br&gt;• base_commit, parent_branch" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="484.0" y="180.0" width="440.0" height="180.0" as="geometry"/></mxCell><mxCell id="ct_e2h" value="ContractSpec (IF-07)" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#1E7B45;strokeColor=#1E7B45;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="938.0" y="150.0" width="440.0" height="30.0" as="geometry"/></mxCell><mxCell id="ct_e2b" value="• module_id, version (semver), status DRAFT | STABLE | DEPRECATED&lt;br&gt;• operations: name, inputs, outputs, errors (schema)&lt;br&gt;• data schemas, invariants, side effects&lt;br&gt;• producer task, consumer tasks&lt;br&gt;• contract-test refs" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="938.0" y="180.0" width="440.0" height="180.0" as="geometry"/></mxCell><mxCell id="ct_e3h" value="ContextPack (IF-11)" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#1E7B45;strokeColor=#1E7B45;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1392.0" y="150.0" width="440.0" height="30.0" as="geometry"/></mxCell><mxCell id="ct_e3b" value="• pack_id, task_id, role, budget, token_count&lt;br&gt;• items[]: tier P0–P5, source ref, hash, tokens&lt;br&gt;• dropped[]: item, reason&lt;br&gt;• overflow flag + must-have sizes" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1392.0" y="180.0" width="440.0" height="180.0" as="geometry"/></mxCell><mxCell id="ct_e4h" value="EventEnvelope (IF-17)" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#1E7B45;strokeColor=#1E7B45;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1846.0" y="150.0" width="440.0" height="30.0" as="geometry"/></mxCell><mxCell id="ct_e4b" value="• event_id (uuid), run_id, task_id?, seq (per run)&lt;br&gt;• ts, actor (agent | service | user), kind&lt;br&gt;• causation_id, correlation_id&lt;br&gt;• payload (small) or payload_ref (blob)&lt;br&gt;• visibility (user | internal), redaction flags" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1846.0" y="180.0" width="440.0" height="180.0" as="geometry"/></mxCell><mxCell id="ct_e5h" value="DecisionRequest (IF-03)" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#1E7B45;strokeColor=#1E7B45;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="380.0" width="440.0" height="30.0" as="geometry"/></mxCell><mxCell id="ct_e5b" value="• decision_id, kind, requester, scope&lt;br&gt;• question, options[], evidence refs&lt;br&gt;• default_on_timeout (safe), deadline&lt;br&gt;• status, answer, answered_by, answered_at" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30.0" y="410.0" width="440.0" height="180.0" as="geometry"/></mxCell><mxCell id="ct_e6h" value="AttemptRecord" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#1E7B45;strokeColor=#1E7B45;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="484.0" y="380.0" width="440.0" height="30.0" as="geometry"/></mxCell><mxCell id="ct_e6b" value="• task_id, attempt n, lease_id, model + tier&lt;br&gt;• context pack id, diff ref, tool calls[]&lt;br&gt;• gate results, failure class, evidence ref&lt;br&gt;• tokens in / out, inference s (measured / est.)" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacing=4;rounded=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;strokeWidth=1;fontColor=#17202A;verticalAlign=top;spacingTop=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="484.0" y="410.0" width="440.0" height="180.0" as="g